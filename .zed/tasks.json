[
 {
    "label": "Run",
    "command": "make",
    "args": ["run"],
    "cwd": "$ZED_WORKTREE_ROOT",

    "allow_concurrent_runs": false,

    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "never",
    "save": "all",
    "show_summary": true,
    "show_command": true,
  },
  {
    "label": "Build Linux",
    "command": "go",
    "args": ["build", "-o", "build/Util.bin"],
    "env": {
      "GOOS": "linux",
      "GOARCH": "amd64",
    },
    "cwd": "$ZED_WORKTREE_ROOT",

    "allow_concurrent_runs": false,

    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "never",
    "save": "all",
    "show_summary": true,
    "show_command": true,
  },

  {
    "label": "Build Windows",
    "command": "go",
    "args": ["build", "-o", "build/Util.exe"],
    "env": {
      "GOOS": "windows",
      "GOARCH": "amd64",
    },
    "cwd": "$ZED_WORKTREE_ROOT",

    "allow_concurrent_runs": false,

    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "never",
    "save": "all",
    "show_summary": true,
    "show_command": true,
  },
]
